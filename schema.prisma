generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ToolStatus {
  DRAFT
  GENERATING
  TESTING
  REVIEW
  PUBLISHED
  ARCHIVED
  FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name         String?
  passwordHash String?
  role         String     @default("USER")
  sessions     Session[]
  auditLogs    AuditLog[]
  creditAccount CreditAccount?
  creditLedger  CreditLedger[]
  files         UserFile[]
  documentOperations DocumentOperation[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model ToolCategory {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  tools Tool[]
}

model Tool {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String
  categoryId  String
  category    ToolCategory       @relation(fields: [categoryId], references: [id])
  manifest    Json
  status      ToolStatus         @default(DRAFT)
  qualityScore Int?
  indexable   Boolean            @default(false)
  versions    ToolVersion[]
  reviews     PublicationReview[]
  seoDrafts   SEOOptimizationDraft[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, categoryId])
}

model ToolVersion {
  id        String   @id @default(cuid())
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  version   Int
  manifest  Json
  createdAt DateTime @default(now())

  @@unique([toolId, version])
}

model TemplateCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  templates Template[]
}

model Template {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  description String
  content     String
  variables   Json
  tags        String[]
  categoryId  String
  category    TemplateCategory @relation(fields: [categoryId], references: [id])
  published   Boolean          @default(false)
  versions    TemplateVersion[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model TemplateVersion {
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version    Int
  content    String
  createdAt  DateTime @default(now())

  @@unique([templateId, version])
}

model AIProvider {
  id          String      @id @default(cuid())
  name        String      @unique
  providerType String
  enabled     Boolean     @default(false)
  priority    Int         @default(100)
  model       String?
  config      Json?
  health      String      @default("UNKNOWN")
  requests    AIRequest[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model AIRequest {
  id         String      @id @default(cuid())
  providerId String?
  provider   AIProvider? @relation(fields: [providerId], references: [id])
  model      String?
  status     String
  latencyMs  Int?
  errorCode  String?
  usage      Json?
  cost       Float?
  createdAt  DateTime    @default(now())

  @@index([createdAt, status])
}

model AIUsage {
  id            String   @id @default(cuid())
  provider      String
  model         String
  requests      Int      @default(1)
  tokens        Int      @default(0)
  estimatedCost Float    @default(0)
  date          DateTime @default(now())

  @@index([provider, date])
}

model AIProviderHealth {
  id        String   @id @default(cuid())
  provider  String
  status    String
  message   String?
  checkedAt DateTime @default(now())

  @@index([provider, checkedAt])
}

model GenerationJob {
  id        String            @id @default(cuid())
  type      String
  status    JobStatus         @default(QUEUED)
  input     Json
  output    Json?
  error     String?
  attempts  Int               @default(0)
  maxAttempts Int             @default(5)
  idempotencyKey String?      @unique
  lockedAt DateTime?
  lockedBy String?
  leaseExpiresAt DateTime?
  heartbeatAt DateTime?
  scheduledAt DateTime        @default(now())
  completedAt DateTime?
  logs      GenerationJobLog[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status, scheduledAt, createdAt])
  @@index([leaseExpiresAt])
}

model GenerationJobLog {
  id        String        @id @default(cuid())
  jobId     String
  job       GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level     String
  message   String
  createdAt DateTime      @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  target    String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  event       String
  path        String?
  toolSlug    String?
  country     String?
  device      String?
  anonymousId String?
  createdAt   DateTime @default(now())

  @@index([event, createdAt])
  @@index([toolSlug, createdAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AdConfiguration {
  id          String   @id @default(cuid())
  publisherId String?
  slots       Json
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model SearchQuery {
  id        String   @id @default(cuid())
  query     String
  count     Int      @default(1)
  createdAt DateTime @default(now())

  @@index([count])
}

model PublicationReview {
  id        String   @id @default(cuid())
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  reviewerId String?
  status    String
  notes     String?
  score     Int?
  createdAt DateTime @default(now())
}


model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}


model SEOKeywordOpportunity {
  id             String   @id @default(cuid())
  keyword        String   @unique
  normalized     String   @unique
  source         String   @default("manual")
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  position       Float?
  status         String   @default("DISCOVERED")
  suggestedSlug  String?
  generatedToolId String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, impressions])
}

model OpportunityCandidate {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  keyword     String
  source      String   @default("manual")
  score       Int      @default(0)
  status      String   @default("DISCOVERED")
  signals     Json
  analysis    Json
  jobId       String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, score, createdAt])
  @@index([source, createdAt])
}


model SEOOptimizationDraft {
  id             String   @id @default(cuid())
  toolId         String
  tool           Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  baseVersion    Int      @default(1)
  proposedSeo    Json
  score          Int
  status         String   @default("PENDING_REVIEW")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([toolId, status, createdAt])
}


model CreditAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String   @default("free")
  periodStart    DateTime
  periodEnd      DateTime
  monthlyCredits Int      @default(500)
  usedCredits    Int      @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([periodEnd])
}

model CreditLedger {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Int
  reason         String
  idempotencyKey String   @unique
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model UserFile {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalName String
  storageKey   String   @unique
  mimeType     String
  extension    String
  sizeBytes    Int
  checksum     String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model DocumentOperation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId      String
  fileName    String
  operation   String
  status      String
  creditsUsed Int      @default(0)
  result      Json?
  errorCode   String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([fileId, createdAt])
}
