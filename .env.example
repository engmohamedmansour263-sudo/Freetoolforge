DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freetoolforge?schema=public"
AUTH_SECRET="replace-with-long-random-secret"
APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-me"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TASKS=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
ANTHROPIC_TASKS=""
GEMINI_API_KEY=""
GEMINI_PAID_MODEL=""
GEMINI_TASKS=""
GEMINI_FREE_API_KEY=""
GEMINI_FREE_MODEL=""
GROQ_API_KEY=""
GROQ_MODEL=""
GROQ_TASKS=""
GROQ_FREE_API_KEY=""
GROQ_FREE_MODEL=""
OPENROUTER_API_KEY=""
OPENROUTER_PAID_MODEL=""
OPENROUTER_TASKS=""
OPENROUTER_FREE_API_KEY=""
OPENROUTER_FREE_MODEL=""
MISTRAL_API_KEY=""
MISTRAL_MODEL=""
MISTRAL_TASKS=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_MODEL=""
CLOUDFLARE_TASKS=""
REDIS_URL=""
GOOGLE_ADSENSE_CLIENT=""
GOOGLE_ANALYTICS_ID=""
# Optional protection for a future scheduled SEO Autopilot worker
CRON_SECRET="replace-with-long-random-secret"
# Google Search Console API (service account; grant this email access to the property)
GOOGLE_SEARCH_CONSOLE_SITE_URL="https://your-domain.com/"
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# AI orchestration controls (0 disables the budget cap)
AI_DAILY_BUDGET_USD=0
AI_MONTHLY_BUDGET_USD=0
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_OPEN_MS=60000
# Optional generic pricing estimate per 1K tokens; model-specific billing should override in a future pricing registry
AI_COST_PER_1K_INPUT_USD=0
AI_COST_PER_1K_OUTPUT_USD=0
# Model-specific price estimates (USD per 1K tokens); set both rates for a model.
# Example keys use normalized PROVIDER_MODEL names; actual rates should be verified against provider pricing.
AI_PRICE_OPENAI_GPT_4O_MINI_INPUT_PER_1K_USD=
AI_PRICE_OPENAI_GPT_4O_MINI_OUTPUT_PER_1K_USD=
AI_PRICE_ANTHROPIC_CLAUDE_3_5_SONNET_INPUT_PER_1K_USD=
AI_PRICE_ANTHROPIC_CLAUDE_3_5_SONNET_OUTPUT_PER_1K_USD=

# Optional shared secret for an external cron/worker invoking POST /api/admin/factory/worker
FACTORY_WORKER_SECRET=

# Autonomous factory background workers
FACTORY_WORKER_ID=factory-worker
FACTORY_WORKER_CONCURRENCY=2
FACTORY_WORKER_POLL_MS=2000

# Factory worker lease / heartbeat tuning
FACTORY_WORKER_LEASE_MS=60000
FACTORY_WORKER_HEARTBEAT_MS=15000
# Daily Search Console sync uses the CRON_SECRET defined above.
